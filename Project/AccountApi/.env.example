# Copy to .env and fill in real values. Never commit .env.
# These are injected into the deployed Lambda as environment variables.
TABLE_NAME=onset-accounts-dev
API_KEY=dev-api-key-change-me-in-production
JWT_SECRET=dev-secret
# Must match the game server's [Onset.Auth] AuthTokenSecret so X-Store-Token signatures validate.
AUTH_TOKEN_SECRET=change-me-in-production
